#!/bin/zsh
set -euo pipefail

PROJECT_DIR="${0:A:h}/../.."
PROJECT_DIR="${PROJECT_DIR:A}"
cd "$PROJECT_DIR"
RUNTIME_DIR="$HOME/Library/Application Support/Downloadable"
mkdir -p "$RUNTIME_DIR"
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

python_supported() {
  local candidate="$1"
  [[ -x "$candidate" ]] || return 1
  "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1
}

echo "Setting up the local downloader…"
PYTHON_BIN="$(command -v python3 || true)"

if [[ -n "$PYTHON_BIN" ]] && ! python_supported "$PYTHON_BIN"; then
  PYTHON_BIN=""
fi

# Prefer a current Homebrew Python over Apple's legacy Command Line Tools
# Python 3.9, which is no longer supported by current yt-dlp releases.
for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  if python_supported "$candidate"; then
    PYTHON_BIN="$candidate"
    break
  fi
done

if [[ -z "$PYTHON_BIN" ]]; then
  echo "Python 3 is required but was not found."
  if command -v brew >/dev/null 2>&1; then
    read -r "INSTALL_PYTHON?Install Python 3 with Homebrew now? (Y/N): "
    if [[ "$INSTALL_PYTHON" == [Yy] ]]; then
      brew install python
      for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3; do
        if python_supported "$candidate"; then
          PYTHON_BIN="$candidate"
          break
        fi
      done
    fi
  else
    echo "Install Python 3 from https://www.python.org/downloads/macos/ or install Homebrew first."
  fi
fi
if [[ -z "$PYTHON_BIN" ]]; then
  echo "Python 3 is still missing. Setup cannot continue."
  read -k 1 "?Press any key to close…"
  echo
  exit 1
fi

BREW_BIN="$(command -v brew || true)"
if [[ -z "$BREW_BIN" ]]; then
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x "$candidate" ]]; then
      BREW_BIN="$candidate"
      break
    fi
  done
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  if [[ -n "$BREW_BIN" ]]; then
    echo "FFmpeg is missing; installing it with Homebrew…"
    "$BREW_BIN" install ffmpeg
  else
    echo "FFmpeg is required, and Homebrew was not found."
    echo "Install Homebrew from https://brew.sh, then rerun this setup."
  fi
fi
if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "FFmpeg is still missing. Setup cannot continue."
  read -k 1 "?Press any key to close…"
  echo
  exit 1
fi

LAUNCH_AGENT="$HOME/Library/LaunchAgents/com.downloadable.helper.plist"
USER_ID="$(id -u)"
SERVICE="gui/$USER_ID/com.downloadable.helper"
mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
launchctl bootout "$SERVICE" 2>/dev/null || true

is_legacy_helper() {
  local pid="$1" owner command_line
  owner="$(ps -p "$pid" -o uid= | tr -d '[:space:]')"
  command_line="$(ps -ww -p "$pid" -o command=)"
  [[ "$owner" == "$USER_ID" && "$command_line" == *python* && "$command_line" == */helper/helper.py ]] &&
    [[ "${command_line:l}" == *downloadable* || "${command_line:l}" == *personal-media-downloader* ]]
}

listener_pids() {
  /usr/sbin/lsof -nP -tiTCP:47821 -sTCP:LISTEN 2>/dev/null || true
}

# Stop the previous helper before pip or venv replacement can change files it
# has loaded or is still using. Only terminate a Downloadable helper owned by
# this user; a different listener is left alone and reported below.
while IFS= read -r pid; do
  if is_legacy_helper "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    for attempt in {1..20}; do
      is_legacy_helper "$pid" || break
      sleep 0.1
    done
    if is_legacy_helper "$pid"; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
done < <(listener_pids)
for attempt in {1..20}; do
  [[ -z "$(listener_pids)" ]] && break
  sleep 0.1
done
if [[ -n "$(listener_pids)" ]]; then
  echo "Setup could not free port 47821. Close the app using that port and run setup again."
  exit 1
fi

# Recreate a damaged runtime venv instead of reusing a partial one. This is
# especially important after a venv was created from a protected Downloads
# location or after Python was upgraded in place.
RUNTIME_PYTHON="$RUNTIME_DIR/.venv/bin/python"
if [[ -e "$RUNTIME_DIR/.venv" && ! -x "$RUNTIME_PYTHON" ]]; then
  rm -rf "$RUNTIME_DIR/.venv"
fi
if [[ ! -x "$RUNTIME_PYTHON" ]]; then
  "$PYTHON_BIN" -m venv "$RUNTIME_DIR/.venv"
fi
"$RUNTIME_PYTHON" -m pip install --upgrade pip yt-dlp mutagen curl-cffi
"$RUNTIME_PYTHON" -c 'import yt_dlp, mutagen, curl_cffi'

if [[ -s "$RUNTIME_DIR/.helper-token" ]]; then
  TOKEN="$(<"$RUNTIME_DIR/.helper-token")"
elif [[ -s .helper-token ]]; then
  TOKEN="$(<.helper-token)"
else
  TOKEN=$("$RUNTIME_DIR/.venv/bin/python" -c 'import secrets; print(secrets.token_urlsafe(32))')
fi
printf '%s\n' "$TOKEN" > .helper-token
chmod 600 .helper-token
printf '// Generated by setup.command.\nglobalThis.HELPER_TOKEN = "%s";\nglobalThis.HELPER_URL = "http://127.0.0.1:47821";\n' "$TOKEN" > extension/config.js

rsync -a --delete helper extension .helper-token "$RUNTIME_DIR/"
if [[ ! -f "$RUNTIME_DIR/extension/manifest.json" ]]; then
  echo "Setup failed: the extension files were not copied to the runtime folder."
  exit 1
fi
sed "s|__HOME__|$HOME|g" com.downloadable.helper.plist > "$LAUNCH_AGENT"
launchctl enable "$SERVICE"
launchctl bootstrap "gui/$USER_ID" "$LAUNCH_AGENT"
launchctl kickstart "$SERVICE"

"$RUNTIME_PYTHON" - "$RUNTIME_DIR" <<'PY'
import json
import sys
import time
import urllib.request
from pathlib import Path

runtime = Path(sys.argv[1])
token = (runtime / ".helper-token").read_text().strip()
version = json.loads((runtime / "extension/manifest.json").read_text())["version"]
request = urllib.request.Request("http://127.0.0.1:47821/state", headers={"X-Helper-Token": token})
deadline = time.monotonic() + 20
while time.monotonic() < deadline:
    try:
        with urllib.request.urlopen(request, timeout=1) as response:
            state = json.load(response)
        if state.get("version") == version and "active_jobs" in state:
            break
    except (OSError, ValueError):
        pass
    time.sleep(0.25)
else:
    sys.exit("Setup installed the helper but it did not respond. Check ~/Library/Logs/Downloadable.error.log.")
PY

echo
echo "Setup complete."
echo "Next: open chrome://extensions, enable Developer mode, and load this folder:"
echo "$PROJECT_DIR/extension"
echo
echo "The local helper is installed as an automatic background service."
if [[ -t 0 ]]; then
  read -k 1 "?Press any key to close…"
  echo
fi
