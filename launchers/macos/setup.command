#!/bin/zsh
set -euo pipefail

PROJECT_DIR="${0:A:h}/../.."
PROJECT_DIR="${PROJECT_DIR:A}"
cd "$PROJECT_DIR"
RUNTIME_DIR="$HOME/Library/Application Support/Downloadable"
mkdir -p "$RUNTIME_DIR"

echo "Setting up the local downloader…"
PYTHON_BIN="$(command -v python3 || true)"

# Prefer a current Homebrew Python over Apple's legacy Command Line Tools
# Python 3.9, which is no longer supported by current yt-dlp releases.
for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  if [[ -x "$candidate" ]]; then
    PYTHON_BIN="$candidate"
    break
  fi
done

if [[ -z "$PYTHON_BIN" ]]; then
  echo "Python 3 is required but was not found."
  if command -v brew >/dev/null 2>&1; then
    read -r "INSTALL_PYTHON?Install Python 3 with Homebrew now? (Y/N): "
    if [[ "$INSTALL_PYTHON" == [Yy] ]]; then
      brew install python
      for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3; do
        if [[ -x "$candidate" ]]; then
          PYTHON_BIN="$candidate"
          break
        fi
      done
    fi
  else
    echo "Install Python 3 from https://www.python.org/downloads/macos/ or install Homebrew first."
  fi
fi
if [[ -z "$PYTHON_BIN" ]]; then
  echo "Python 3 is still missing. Setup cannot continue."
  read -k 1 "?Press any key to close…"
  echo
  exit 1
fi

BREW_BIN="$(command -v brew || true)"
if [[ -z "$BREW_BIN" ]]; then
  for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x "$candidate" ]]; then
      BREW_BIN="$candidate"
      break
    fi
  done
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  if [[ -n "$BREW_BIN" ]]; then
    echo "FFmpeg is missing; installing it with Homebrew…"
    "$BREW_BIN" install ffmpeg
  else
    echo "FFmpeg is required, and Homebrew was not found."
    echo "Install Homebrew from https://brew.sh, then rerun this setup."
  fi
fi
if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "FFmpeg is still missing. Setup cannot continue."
  read -k 1 "?Press any key to close…"
  echo
  exit 1
fi

launchctl bootout "gui/$(id -u)/com.downloadable.helper" 2>/dev/null || true

# Stop helpers from older installs too. This is intentionally scoped to
# Downloadable helper command lines so unrelated Python processes are left
# alone before the runtime directory is replaced.
OLD_HELPERS=($(ps -axo pid=,command= | awk -v self="$$" '$1 != self && /helper\/helper\.py/ && /[Dd]ownloadable|personal-media-downloader/ {print $1}'))
if (( ${#OLD_HELPERS} )); then
  kill -TERM $OLD_HELPERS 2>/dev/null || true
  sleep 1
  kill -KILL $OLD_HELPERS 2>/dev/null || true
fi

# Recreate a damaged runtime venv instead of reusing a partial one. This is
# especially important after a venv was created from a protected Downloads
# location or after Python was upgraded in place.
RUNTIME_PYTHON="$RUNTIME_DIR/.venv/bin/python"
if [[ -e "$RUNTIME_DIR/.venv" && ! -x "$RUNTIME_PYTHON" ]]; then
  rm -rf "$RUNTIME_DIR/.venv"
fi
if [[ ! -x "$RUNTIME_PYTHON" ]]; then
  "$PYTHON_BIN" -m venv "$RUNTIME_DIR/.venv"
fi
"$RUNTIME_PYTHON" -m pip install --upgrade pip yt-dlp mutagen curl-cffi
"$RUNTIME_PYTHON" -c 'import yt_dlp, mutagen, curl_cffi'

if [[ -s .helper-token ]]; then
  IFS= read -r TOKEN < .helper-token
else
  TOKEN=$("$RUNTIME_DIR/.venv/bin/python" -c 'import secrets; print(secrets.token_urlsafe(32))')
  printf '%s\n' "$TOKEN" > .helper-token
fi
chmod 600 .helper-token
printf '// Generated by setup.command.\nglobalThis.HELPER_TOKEN = "%s";\nglobalThis.HELPER_URL = "http://127.0.0.1:47821";\n' "$TOKEN" > extension/config.js

LAUNCH_AGENT="$HOME/Library/LaunchAgents/com.downloadable.helper.plist"
mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
rsync -a --delete helper extension .helper-token "$RUNTIME_DIR/"
if [[ ! -f "$RUNTIME_DIR/extension/manifest.json" ]]; then
  echo "Setup failed: the extension files were not copied to the runtime folder."
  exit 1
fi
sed "s|__HOME__|$HOME|g" com.downloadable.helper.plist > "$LAUNCH_AGENT"
launchctl bootstrap "gui/$(id -u)" "$LAUNCH_AGENT"
launchctl enable "gui/$(id -u)/com.downloadable.helper"
launchctl kickstart -k "gui/$(id -u)/com.downloadable.helper"

echo
echo "Setup complete."
echo "Next: open chrome://extensions, enable Developer mode, and load this folder:"
echo "$PROJECT_DIR/extension"
echo
echo "The local helper is installed as an automatic background service."
if [[ -t 0 ]]; then
  read -k 1 "?Press any key to close…"
  echo
fi
