{
  "manifest_version": 3,
  "name": "Personal Video & Audio Downloader",
  "version": "1.3.0",
  "description": "Save the current YouTube or TikTok video as MP3 or MP4 through a local helper.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": [
    "http://127.0.0.1:47821/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Download this video",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  }
}
